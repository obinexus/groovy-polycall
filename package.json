{
  "name": "@obinexusltd/groovy-polycall",
  "version": "1.0.0",
  "description": "Groovy binding for the Polycall binding ABI v1 (Foreign Function & Memory API, JDK 22+). Source distribution of a Gradle project; not a JavaScript library.",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "src/",
    "examples/",
    "scripts/",
    "tests/package.test.js",
    "build.gradle",
    "settings.gradle",
    "groovy-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "lib": "src/main/groovy",
    "test": "src/test/groovy"
  },
  "scripts": {
    "build": "gradle --no-daemon assemble",
    "test": "sh scripts/test.sh",
    "test:package": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/groovy-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "groovy",
    "ffm",
    "ffi"
  ],
  "author": {
    "name": "Nnamdi Michael Okpala",
    "email": "okpalan@protonmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/groovy-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/groovy-polycall#readme"
}
